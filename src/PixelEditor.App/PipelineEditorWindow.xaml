<Window x:Class="PixelEditor.App.PipelineEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        Width="1040" Height="680" MinWidth="860" MinHeight="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Step or check card: a header with the number and buttons, parameters below as fields -->
        <DataTemplate x:Key="StepCard">
            <Border Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Control}" Padding="10,8" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="↑" Style="{StaticResource IconButton}" ToolTip="{loc:T pipeline_editor.up.tip}"
                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button Content="↓" Style="{StaticResource IconButton}" ToolTip="{loc:T pipeline_editor.down.tip}"
                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            <Button Content="✕" Style="{StaticResource IconButton}" ToolTip="{loc:T pipeline_editor.remove.tip}"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Number}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource MonoText}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Style="{StaticResource MonoText}"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource MonoTextBox}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Type}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="44"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="{loc:T common.name}"/>
                <TextBox Margin="0,4,0,10" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{loc:T common.description_optional}"/>
                <TextBox Margin="0,4,0,0" Height="52" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="{loc:T pipeline_editor.processing_steps_run_from_top}" Style="{StaticResource SectionTitleText}" Margin="0,18,0,6"/>
                <TextBlock Text="{loc:T pipeline_editor.add_the_operations_you_need}"
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepCard}"/>
                <DockPanel Margin="0,0,0,2">
                    <Button DockPanel.Dock="Right" Content="{loc:T pipeline_editor.add_step}" Margin="8,0,0,0" Command="{Binding AddStepCommand}"/>
                    <ComboBox ItemsSource="{Binding OperationCatalog}" SelectedItem="{Binding StepToAdd}" DisplayMemberPath="Name"/>
                </DockPanel>
                <TextBlock Text="{Binding StepToAddHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="{loc:T pipeline_editor.result_checks}" Style="{StaticResource SectionTitleText}" Margin="0,22,0,6"/>
                <TextBlock Text="{loc:T pipeline_editor.a_check_is_a_readiness}"
                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding CheckRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <ContentPresenter ContentTemplate="{StaticResource StepCard}" Content="{Binding}"/>
                                <CheckBox Content="{loc:T pipeline_editor.required_otherwise_only_a_warning}" IsChecked="{Binding Required}" Margin="10,-2,0,8"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,0,0,2">
                    <Button DockPanel.Dock="Right" Content="{loc:T pipeline_editor.add_check}" Margin="8,0,0,0" Command="{Binding AddCheckCommand}"/>
                    <ComboBox ItemsSource="{Binding CheckCatalog}" SelectedItem="{Binding CheckToAdd}" DisplayMemberPath="Name"/>
                </DockPanel>
                <TextBlock Text="{Binding CheckToAddHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:T pipeline_editor.resulting_json}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6"/>
                <TextBox Style="{StaticResource ReadOnlyMonoTextBox}" Text="{Binding Json, Mode=OneWay}" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,10">
                <Button Content="{loc:T pipeline_editor.test_on_current_layer}" Command="{Binding TestCommand}"/>
                <TextBlock Text="{loc:T pipeline_editor.the_document_is_not_changed}" Style="{StaticResource CaptionText}"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBox Grid.Row="2" Style="{StaticResource ReadOnlyMonoTextBox}" Text="{Binding TestResult, Mode=OneWay}" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:T pipeline_editor.save_to_library}" IsDefault="True" Style="{StaticResource PrimaryButton}" Padding="16,3" Margin="0,0,8,0"
                        Command="{Binding SaveCommand}"/>
                <Button Content="{loc:T common.cancel}" IsCancel="True" Width="90" Command="{Binding CancelCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
