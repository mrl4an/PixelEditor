<Window x:Class="PixelEditor.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        Width="960" Height="440" MinWidth="560" MinHeight="260" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- The picture at the chosen zoom: the same in all three fields -->
        <DataTemplate x:Key="Pane">
            <Image Source="{Binding Image, Converter={StaticResource PixelBitmap}}" Stretch="Fill"
                   Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Margin="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{loc:T preview.zoom}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedText}"/>
                <RadioButton Content="1×" Style="{StaticResource ChipStyle}" Width="34" Height="26" GroupName="Z"
                             IsChecked="{Binding Scale, Converter={StaticResource EnumBool}, ConverterParameter=1}"/>
                <RadioButton Content="2×" Style="{StaticResource ChipStyle}" Width="34" Height="26" GroupName="Z"
                             IsChecked="{Binding Scale, Converter={StaticResource EnumBool}, ConverterParameter=2}"/>
                <RadioButton Content="4×" Style="{StaticResource ChipStyle}" Width="34" Height="26" GroupName="Z"
                             IsChecked="{Binding Scale, Converter={StaticResource EnumBool}, ConverterParameter=4}"/>
                <RadioButton Content="8×" Style="{StaticResource ChipStyle}" Width="34" Height="26" GroupName="Z"
                             IsChecked="{Binding Scale, Converter={StaticResource EnumBool}, ConverterParameter=8}"/>
            </StackPanel>
            <TextBlock Text="{Binding Info}" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{loc:T preview.on_white}" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="White">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pane}"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{loc:T preview.on_transparent_grid}" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{StaticResource Brush.CheckerLarge}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pane}"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="{loc:T preview.on_black}" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="Black">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Pane}"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
