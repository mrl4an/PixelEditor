<Window x:Class="PixelEditor.App.ImageSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        SizeToContent="Height" Width="440" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18,16,18,16" FocusManager.FocusedElement="{Binding ElementName=WidthBox}">
        <TextBlock Text="{Binding CurrentInfo}" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
        <TextBlock Text="{loc:T image_size.scales_the_picture_with_all}"
                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:T common.width}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="WidthBox" Grid.Column="1" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Column="2" Text="{loc:T common.height}" VerticalAlignment="Center" Margin="14,0,8,0"/>
            <TextBox Grid.Column="3" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <CheckBox Content="{loc:T common.keep_proportions}" Margin="0,10,0,0" IsChecked="{Binding KeepAspect}"/>

        <DockPanel Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{loc:T image_size.scale}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Right" Content="{loc:T image_size.reset}" Margin="6,0,0,0" Command="{Binding ResetCommand}"/>
            <Button DockPanel.Dock="Right" Content="×2" Width="40" Margin="6,0,0,0" Command="{Binding ScaleCommand}" CommandParameter="2"/>
            <Button DockPanel.Dock="Right" Content="÷2" Width="40" Margin="6,0,0,0" Command="{Binding ScaleCommand}" CommandParameter="0.5"/>
            <TextBox Text="{Binding PercentText, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <TextBlock Text="{loc:T image_size.method}" Margin="0,14,0,4"/>
        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Title"/>
        <TextBlock Text="{Binding Hint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <TextBlock Style="{StaticResource ErrorText}" Margin="0,8,0,0" Text="{Binding Error}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:T common.apply}" IsDefault="True" MinWidth="100" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                    Command="{Binding OkCommand}"/>
            <Button Content="{loc:T common.cancel}" IsCancel="True" Width="80" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
