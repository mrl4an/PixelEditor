<Window x:Class="PixelEditor.App.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" MinWidth="320" FocusManager.FocusedElement="{Binding ElementName=InputBox}">
        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="380"/>
        <TextBox x:Name="InputBox" Margin="0,8,0,0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Width="80" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                    Command="{Binding OkCommand}"/>
            <Button Content="{loc:T common.cancel}" IsCancel="True" Width="80" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
