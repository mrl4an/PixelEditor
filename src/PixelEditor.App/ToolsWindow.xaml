<Window x:Class="PixelEditor.App.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        Width="780" Height="620" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- One reference row template: multi-line text with wrapping -->
        <DataTemplate x:Key="ReferenceRow">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,5"/>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="{loc:T tools.operations}">
                <ListBox ItemsSource="{Binding Operations}" ItemTemplate="{StaticResource ReferenceRow}" Margin="0,8,0,0"/>
            </TabItem>
            <TabItem Header="{loc:T tools.checks}">
                <ListBox ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource ReferenceRow}" Margin="0,8,0,0"/>
            </TabItem>
            <TabItem Header="{loc:T tools.plugins}">
                <ListBox ItemsSource="{Binding Plugins}" ItemTemplate="{StaticResource ReferenceRow}" Margin="0,8,0,0"/>
            </TabItem>
            <TabItem Header="{loc:T tools.ai_connection}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <TextBlock Text="{Binding AiText}" TextWrapping="Wrap" Style="{StaticResource MonoText}" FontSize="12" Margin="4"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:T tools.open_plugins_folder}" Command="{Binding OpenPluginsFolderCommand}" Margin="0,0,8,0"/>
            <Button Content="{loc:T tools.open_templates_folder}" Command="{Binding OpenTemplatesFolderCommand}" Margin="0,0,8,0"/>
            <Button Content="{loc:T common.close}" IsCancel="True" Command="{Binding CancelCommand}" Width="84"/>
        </StackPanel>
    </Grid>
</Window>
