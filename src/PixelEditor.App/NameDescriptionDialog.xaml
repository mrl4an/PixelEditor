<Window x:Class="PixelEditor.App.NameDescriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        xmlns:local="clr-namespace:PixelEditor.App"
        SizeToContent="Height" Width="440" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18,16,18,16" FocusManager.FocusedElement="{Binding ElementName=NameBox}">
        <TextBlock Text="{Binding Hint}" Margin="0,0,0,10" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Hint}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <local:SwatchStrip Colors="{Binding Colors}" SwatchSize="14" MaxHeight="74" HorizontalAlignment="Left" Margin="0,0,0,2"/>
        <TextBlock Text="{Binding ColorsInfo}" Style="{StaticResource CaptionText}" Margin="0,2,0,10"/>

        <TextBlock Text="{loc:T common.name}"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,10" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{loc:T common.description_optional}"/>
        <TextBox Margin="0,4,0,0" Height="64" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Style="{StaticResource ErrorText}" Margin="0,8,0,0" Text="{Binding Error}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding OkText}" IsDefault="True" MinWidth="100" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                    Command="{Binding OkCommand}"/>
            <Button Content="{loc:T common.cancel}" IsCancel="True" Width="80" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
