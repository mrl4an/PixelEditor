<Window x:Class="PixelEditor.App.TemplateLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        Width="860" Height="580" MinWidth="720" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource DetailTitleText}"/>
                <TextBlock Text="{Binding Selected.Summary}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                <TextBlock Text="{loc:T template_lib.what_it_does}" Style="{StaticResource SectionTitleText}" Margin="0,16,0,6"/>
                <ItemsControl ItemsSource="{Binding Outline}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SystemHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"/>

                <TextBlock Text="{loc:T template_lib.actions}" Style="{StaticResource SectionTitleText}" Margin="0,18,0,6"/>
                <WrapPanel>
                    <Button Content="{loc:T template_lib.apply_to_layer}" Style="{StaticResource PrimaryButton}" Padding="14,3" Margin="0,0,6,6"
                            Command="{Binding RunCommand}"/>
                    <Button Content="{loc:T template_lib.create_new}" Margin="0,0,6,6" Command="{Binding NewCommand}"/>
                    <Button Content="{loc:T template_lib.copy}" Margin="0,0,6,6" Command="{Binding DuplicateCommand}"/>
                    <Button Content="{loc:T template_lib.edit}" Margin="0,0,6,6" Command="{Binding EditCommand}"/>
                    <Button Content="{loc:T common.delete}" Margin="0,0,6,6" Command="{Binding DeleteCommand}"/>
                </WrapPanel>

                <TextBlock Text="{loc:T common.files}" Style="{StaticResource SectionTitleText}" Margin="0,12,0,6"/>
                <WrapPanel>
                    <Button Content="{loc:T template_lib.import_json}" Margin="0,0,6,6" Command="{Binding ImportCommand}"/>
                    <Button Content="{loc:T common.export}" Margin="0,0,6,6" Command="{Binding ExportCommand}"/>
                    <Button Content="{loc:T template_lib.templates_folder}" Margin="0,0,6,6" Command="{Binding OpenFolderCommand}"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:T common.close}" IsCancel="True" Width="90" Command="{Binding CancelCommand}"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
