<Window x:Class="PixelEditor.App.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        Width="820" Height="680" MinWidth="740" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding SourceInfo}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <GroupBox Header="{loc:T import.size}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T common.width}" Style="{StaticResource MutedText}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Bottom" Margin="6,0,6,5" Style="{StaticResource MutedText}"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:T common.height}" Style="{StaticResource MutedText}" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:T import.quick_long_side}" Style="{StaticResource CaptionText}" Margin="0,8,0,3"/>
                        <WrapPanel>
                            <Button Content="{loc:T import.original}" Margin="0,0,4,4" Command="{Binding OriginalSizeCommand}"
                                    ToolTip="{loc:T import.insert_the_picture_at_its.tip}"/>
                            <Button Content="32" Margin="0,0,4,4" MinWidth="36" Command="{Binding SetLongestSideCommand}" CommandParameter="32"/>
                            <Button Content="64" Margin="0,0,4,4" MinWidth="36" Command="{Binding SetLongestSideCommand}" CommandParameter="64"/>
                            <Button Content="128" Margin="0,0,4,4" MinWidth="40" Command="{Binding SetLongestSideCommand}" CommandParameter="128"/>
                        </WrapPanel>
                        <CheckBox Content="{loc:T common.keep_proportions}" IsChecked="{Binding KeepAspect}" Margin="0,6,0,0"/>
                        <CheckBox Content="{loc:T import.trim_empty_edges}" IsChecked="{Binding TrimEmpty}" Margin="0,6,0,0"/>
                        <TextBlock Text="{loc:T import.downscale_method}" Style="{StaticResource MutedText}" Margin="0,8,0,3"/>
                        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Title"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{loc:T import.colors_and_transparency}" Margin="0,8,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T import.alpha_threshold_0_255}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding AlphaText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T import.max_colors_0_no_limit}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxColorsText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <CheckBox Content="{loc:T import.fit_to_current_palette}" IsChecked="{Binding UsePalette}"
                                  IsEnabled="{Binding UsePaletteEnabled}" Margin="0,8,0,0"/>
                        <CheckBox Content="{loc:T import.dithering_floyd_steinberg}" IsChecked="{Binding Dither}" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{loc:T import.cleanup_and_outline}" Margin="0,8,0,0">
                    <StackPanel>
                        <CheckBox Content="{loc:T common.merge_rare_colors_3_pixels}" IsChecked="{Binding MergeRareColors}"/>
                        <CheckBox Content="{loc:T common.remove_single_pixels}" IsChecked="{Binding RemoveIslands}" Margin="0,6,0,0"/>
                        <CheckBox Content="{loc:T import.fill_single_holes}" IsChecked="{Binding FillHoles}" Margin="0,6,0,0"/>
                        <CheckBox Content="{loc:T import.black_outline_outside}" IsChecked="{Binding Outline}" Margin="0,6,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{loc:T import.import_to}" Margin="0,8,0,0">
                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Title"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Result -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}"
                    Background="{StaticResource Brush.CheckerLarge}" ClipToBounds="True">
                <Image Source="{Binding Preview, Converter={StaticResource PixelBitmap}}" Stretch="Uniform" Margin="8"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
            </Border>
            <TextBlock Grid.Row="1" Text="{Binding ResultInfo}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" Margin="0,8,0,6"/>
            <TextBox Grid.Row="2" Style="{StaticResource ReadOnlyMonoTextBox}" Text="{Binding PipelineJson, Mode=OneWay}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="{loc:T import.save_as_pipeline_template}" Command="{Binding SaveTemplateCommand}"/>
                <Button DockPanel.Dock="Right" Content="{loc:T import.import}" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        Width="120" Command="{Binding ImportCommand}"/>
                <Button DockPanel.Dock="Right" Content="{loc:T common.cancel}" IsCancel="True" Width="84" Margin="0,0,7,0" Command="{Binding CancelCommand}"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
