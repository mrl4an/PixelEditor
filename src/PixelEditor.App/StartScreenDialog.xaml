<Window x:Class="PixelEditor.App.StartScreenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        Width="940" Height="380" MinWidth="820" MinHeight="340" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="1.3*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>

        <!-- Create -->
        <StackPanel>
            <TextBlock Text="{loc:T start.create}" Style="{StaticResource SectionTitleText}" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock Text="{loc:T start.blank_canvas}" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Sizes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding DataContext.NewSizeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" MinWidth="64" Margin="0,0,6,6"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{loc:T start.other_size}" Command="{Binding OtherSizeCommand}" HorizontalContentAlignment="Left" Margin="0,6,0,6"/>
            <Button Content="{loc:T start.animation_sheet}" Command="{Binding AnimationSheetCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
            <Button Content="{loc:T start.rsi_state}" Command="{Binding RsiStateCommand}" HorizontalContentAlignment="Left"/>
        </StackPanel>

        <!-- Open -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="{loc:T start.open}" Style="{StaticResource SectionTitleText}" FontSize="16" Margin="0,0,0,10"/>
            <Button Content="{loc:T start.open_project}" Command="{Binding OpenCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
            <Button Content="{loc:T start.import_picture}" Command="{Binding ImportCommand}" HorizontalContentAlignment="Left"/>
        </StackPanel>

        <!-- Recent -->
        <DockPanel Grid.Column="4">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T start.recent}" Style="{StaticResource SectionTitleText}" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock DockPanel.Dock="Top" Text="{loc:T start.no_recent}" Style="{StaticResource MutedText}">
                <TextBlock.Visibility>
                    <Binding Path="HasNoRecent">
                        <Binding.Converter>
                            <BooleanToVisibilityConverter/>
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Visibility>
            </TextBlock>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,0,0,6" ToolTip="{Binding Path}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Folder}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Bottom -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,14,0,0" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" Content="{loc:T start.show_at_startup}" IsChecked="{Binding ShowAtStartup}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="{loc:T common.close}" IsCancel="True" IsDefault="True" Width="90" Command="{Binding CancelCommand}"/>
        </DockPanel>
    </Grid>
</Window>
