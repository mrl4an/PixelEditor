<UserControl x:Class="PixelEditor.App.SwatchStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Palette color strip: Colors accepts any list of uint (0xAARRGGBB). Tile size is set by SwatchSize. -->
    <ItemsControl ItemsSource="{Binding Colors, ElementName=Root}" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Width="{Binding SwatchSize, ElementName=Root}" Height="{Binding SwatchSize, ElementName=Root}" Margin="0,0,1,1"
                        Background="{Binding Converter={StaticResource ColorBrush}}" BorderBrush="#55000000" BorderThickness="1"
                        ToolTip="{Binding Converter={StaticResource ColorHex}}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
