<Window x:Class="PixelEditor.App.RsiProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        xmlns:vm="clr-namespace:PixelEditor.ViewModels;assembly=PixelEditor.ViewModels"
        SizeToContent="Height" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18,16,18,16">
        <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolVisible}}">
            <TextBlock Text="{loc:T rsi_project.where_to_create}"/>
            <DockPanel Margin="0,4,0,10">
                <Button DockPanel.Dock="Right" Content="{loc:T common.browse}" Margin="6,0,0,0" Command="{Binding BrowseCommand}"/>
                <TextBox Text="{Binding ParentFolder, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <TextBlock Text="{loc:T rsi_project.name_the_folder_gets_the}"/>
            <TextBox Margin="0,4,0,4" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="{Binding FullPath}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:T common.frame_width_px}"/>
                <TextBox Margin="0,4,0,0" IsEnabled="{Binding CanEditSize}" Text="{Binding FrameWidthText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{loc:T common.frame_height_px}"/>
                <TextBox Margin="0,4,0,0" IsEnabled="{Binding CanEditSize}" Text="{Binding FrameHeightText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="{loc:T rsi_project.one_frame_size_for_the}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,10"/>

        <TextBlock Text="{loc:T rsi_project.license}"/>
        <ComboBox Margin="0,4,0,10" IsEditable="True" Text="{Binding License, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{x:Static vm:RsiProjectViewModel.CommonLicenses}"/>
        <TextBlock Text="{loc:T rsi_project.copyright_who_drew_it_source}"/>
        <TextBox Margin="0,4,0,0" Height="56" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                 Text="{Binding Copyright, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Style="{StaticResource ErrorText}" Margin="0,8,0,0" Text="{Binding Error}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding OkText}" IsDefault="True" MinWidth="100" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Command="{Binding OkCommand}"/>
            <Button Content="{loc:T common.cancel}" IsCancel="True" Width="80" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
