<Window x:Class="PixelEditor.App.ResultPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        Width="860" Height="620" MinWidth="680" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{loc:T result_preview.before_current_layer}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6"/>
        <TextBlock Grid.Column="2" Text="{loc:T result_preview.after}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,6"/>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{StaticResource Brush.CheckerLarge}" ClipToBounds="True">
            <Image Source="{Binding Before, Converter={StaticResource PixelBitmap}}" Stretch="Uniform" Margin="10"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
        </Border>
        <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="{StaticResource Brush.CheckerLarge}" ClipToBounds="True">
            <Image Source="{Binding After, Converter={StaticResource PixelBitmap}}" Stretch="Uniform" Margin="10"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
        </Border>

        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:T result_preview.what_will_change}" Style="{StaticResource SectionTitleText}"/>
                <TextBlock Text="{Binding SummaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{loc:T result_preview.steps_and_checks}" Style="{StaticResource SectionTitleText}"/>
                <TextBox Style="{StaticResource ReadOnlyMonoTextBox}" Text="{Binding DetailsText, Mode=OneWay}" Height="110" Margin="0,4,0,0"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{Binding ApplyText}" IsDefault="True" Style="{StaticResource PrimaryButton}" Padding="18,3" Margin="0,0,8,0"
                    Command="{Binding ApplyCommand}"/>
            <Button Content="{loc:T common.cancel}" IsCancel="True" Width="90" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
