<!-- Light theme tokens (from the Figma layout: src/index.css, the .app.light block). The keys are the same as in Palette.Dark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Accent">#0078D4</Color>
    <Color x:Key="Color.AccentStrong">#0067B8</Color>
    <Color x:Key="Color.Shadow">#000000</Color>

    <!-- surfaces -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.Surface2" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="Brush.Surface3" Color="#E9E9E9"/>
    <SolidColorBrush x:Key="Brush.Field" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Workspace" Color="#C9C9C9"/>

    <!-- lines -->
    <SolidColorBrush x:Key="Brush.Border" Color="#D3D3D3"/>
    <SolidColorBrush x:Key="Brush.BorderHi" Color="#BCBCBC"/>

    <!-- text -->
    <SolidColorBrush x:Key="Brush.Text" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#666666"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>

    <!-- states -->
    <SolidColorBrush x:Key="Brush.Hover" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Brush.Selected" Color="#D8EFFB"/>
    <SolidColorBrush x:Key="Brush.SelectedBorder" Color="#7A0078D4"/>
    <SolidColorBrush x:Key="Brush.RowSelectedBorder" Color="#590078D4"/>

    <!-- accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#0078D4"/>
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="#0067B8"/>
    <SolidColorBrush x:Key="Brush.AccentStrongHover" Color="#0A6FC2"/>
    <SolidColorBrush x:Key="Brush.AccentStrongBorder" Color="#004D8A"/>

    <!-- statuses -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#9D5D00"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#107C10"/>
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#22107C10"/>
</ResourceDictionary>
