<!--
  Токены тёмной темы (из макета Figma: src/index.css, блок :root).
  Набор ключей одинаков в Palette.Light.xaml: ThemeManager подменяет весь словарь целиком,
  а все стили и окна ссылаются на ключи через DynamicResource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Accent">#4CC2FF</Color>
    <Color x:Key="Color.AccentStrong">#0078D4</Color>
    <Color x:Key="Color.Shadow">#000000</Color>

    <!-- surfaces -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#202020"/>
    <SolidColorBrush x:Key="Brush.Surface2" Color="#292929"/>
    <SolidColorBrush x:Key="Brush.Surface3" Color="#323232"/>
    <SolidColorBrush x:Key="Brush.Field" Color="#191919"/>
    <SolidColorBrush x:Key="Brush.Workspace" Color="#3A3A3A"/>

    <!-- lines -->
    <SolidColorBrush x:Key="Brush.Border" Color="#3E3E3E"/>
    <SolidColorBrush x:Key="Brush.BorderHi" Color="#505050"/>

    <!-- text -->
    <SolidColorBrush x:Key="Brush.Text" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>

    <!-- states -->
    <SolidColorBrush x:Key="Brush.Hover" Color="#353535"/>
    <SolidColorBrush x:Key="Brush.Selected" Color="#14394A"/>
    <SolidColorBrush x:Key="Brush.SelectedBorder" Color="#7A4CC2FF"/>
    <SolidColorBrush x:Key="Brush.RowSelectedBorder" Color="#594CC2FF"/>

    <!-- accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="Brush.AccentStrong" Color="#0078D4"/>
    <SolidColorBrush x:Key="Brush.AccentStrongHover" Color="#1F8AE0"/>
    <SolidColorBrush x:Key="Brush.AccentStrongBorder" Color="#005A9F"/>

    <!-- statuses -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#FCE100"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#6CCB75"/>
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#33107C10"/>
</ResourceDictionary>
