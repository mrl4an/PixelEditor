<!--
  Кнопки. Неявные стили (без ключа) применяются ко всем Button и ToggleButton приложения.
  Ключевые варианты: PrimaryButton, ToolButtonStyle (RadioButton), ChipStyle (RadioButton), LockToggleStyle (ToggleButton).
  Цвета только через DynamicResource на токены темы.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:PixelEditor.App.Themes"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- Plain button -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderHi}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource Padding.Button}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary button (accent fill) -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.AccentStrong}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentStrongBorder}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentStrongHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square button with a symbol (for example + - ↑ ↓) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="28"/>
    </Style>

    <!-- Toggle: when on it is highlighted with the selection color -->
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderHi}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{DynamicResource Padding.Button}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.SelectedBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tool button: icon | name | hotkey; the active one gets an accent strip on the left.
         The data is set with the attached properties ui:Ui.Icon and ui:Ui.Hotkey. -->
    <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Height" Value="{DynamicResource Size.Tool}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}" SnapsToDevicePixels="True">
                        <Grid Margin="7,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="Bar" Grid.ColumnSpan="3" Width="3" Height="18" RadiusX="2" RadiusY="2" HorizontalAlignment="Left"
                                       Margin="-8,0,0,0" Fill="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
                            <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="Icon" Data="{Binding (ui:Ui.IconData), RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{DynamicResource Brush.Muted}" StrokeThickness="1.7" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0" RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding (ui:Ui.Hotkey), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Muted}"
                                       VerticalAlignment="Center" TextAlignment="Right" MinWidth="14"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.SelectedBorder}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="ui:Ui.IconFilled" Value="True">
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Brush.Muted}"/>
                            <Setter TargetName="Icon" Property="StrokeThickness" Value="0.6"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="ui:Ui.IconFilled" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Brush.Accent}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip: a small selectable square (anchor choice and the like) -->
    <Style x:Key="ChipStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface3}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderHi}"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window title buttons (minimize, maximize). The action is set by ui:Ui.WindowAction. Symbols from Segoe MDL2 Assets. -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close button: red on hover -->
    <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Theme switch in the title bar: a track with a thumb and a label -->
    <Style x:Key="ThemeSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" Height="32" Padding="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="22" Height="12" CornerRadius="8" Background="{DynamicResource Brush.Surface3}"
                                    BorderBrush="{DynamicResource Brush.BorderHi}" BorderThickness="1" Margin="0,0,6,0">
                                <Ellipse x:Name="Knob" Width="8" Height="8" HorizontalAlignment="Left" Margin="2,0,0,0"
                                         Fill="{DynamicResource Brush.Muted}"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" MinWidth="52"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Layer lock: □ off, ▣ on, no border -->
    <!-- Layer visibility eye: open and accent colored when the layer is visible; crossed out and dim when hidden -->
    <Style x:Key="EyeToggleStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="4,0">
                        <TextBlock x:Name="Glyph" Text="&#xED1A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Opacity="0.55"
                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE7B3;"/>
                            <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LockToggleStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="5,0">
                        <TextBlock x:Name="Glyph" Text="□" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="▣"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
