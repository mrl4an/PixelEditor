<Window x:Class="PixelEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:PixelEditor.App.Themes"
        xmlns:local="clr-namespace:PixelEditor.App"
        Title="Pixel Editor" ui:Ui.Subtitle="{Binding DocumentName}" ui:Ui.TitleContent="{DynamicResource ThemeSwitch}"
        Width="1320" Height="820" MinWidth="1080" MinHeight="680"
        AllowDrop="True" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput" PreviewKeyUp="Window_PreviewKeyUp" Deactivated="Window_Deactivated" Closing="Window_Closing" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Theme switch in the window's own title bar. x:Shared=False: a new instance on every use -->
        <StackPanel x:Key="ThemeSwitch" x:Shared="False" Orientation="Horizontal">
            <Menu Background="Transparent" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="{Binding CurrentLanguageCode}" ItemsSource="{Binding Languages}" ToolTip="{loc:T menu.language}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="IsCheckable" Value="True"/>
                            <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=OneWay}"/>
                            <Setter Property="Command" Value="{Binding Command}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </Menu>
            <ToggleButton Style="{StaticResource ThemeSwitchStyle}" Content="{Binding ThemeLabel}"
                      IsChecked="{Binding IsThemeLight, Mode=OneWay}" Command="{Binding ToggleThemeCommand}"
                      ToolTip="{loc:T main.switch_between_dark_and_light.tip}"/>
        </StackPanel>

        <!-- RSI items that need an open RSI state: a disabled item explains how to enable it -->
        <Style x:Key="RsiGatedItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="{loc:T menu.rsi_needs_project.tip}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RsiSaveStateItem" TargetType="MenuItem" BasedOn="{StaticResource RsiGatedItem}">
            <Setter Property="ToolTip" Value="{loc:T main.writes_the_state_png_and.tip}"/>
        </Style>
    </Window.Resources>

    <!-- Ctrl shortcuts go through view model commands. If focus is in a text box, Ctrl+C/V/Z/A is handled by the box itself. -->
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportPngCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding Rsi.ExportAgainCommand}"/>
        <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+V" Command="{Binding ImportClipboardCommand}"/>
        <KeyBinding Gesture="Ctrl+C" Command="{Binding Canvas.CopyCommand}"/>
        <KeyBinding Gesture="Ctrl+X" Command="{Binding Canvas.CutCommand}"/>
        <KeyBinding Gesture="Ctrl+V" Command="{Binding Canvas.PasteCommand}"/>
        <KeyBinding Gesture="Ctrl+A" Command="{Binding Canvas.SelectAllCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding Canvas.DeselectCommand}"/>
        <KeyBinding Gesture="Ctrl+J" Command="{Binding Layers.DuplicateCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding Layers.AddCommand}"/>
        <KeyBinding Key="F2" Command="{Binding Layers.RenameSelectedCommand}"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding Canvas.FitCommand}"/>
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding Canvas.FitCommand}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding Canvas.ZoomActualCommand}"/>
        <KeyBinding Key="NumPad1" Modifiers="Control" Command="{Binding Canvas.ZoomActualCommand}"/>
    </Window.InputBindings>


    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{loc:T menu.file}">
                <MenuItem Header="{loc:T menu.new}" InputGestureText="Ctrl+N" Command="{Binding NewCommand}"/>
                <MenuItem Header="{loc:T menu.start_screen}" Command="{Binding StartScreenCommand}"/>
                <MenuItem Header="{loc:T menu.open_project}" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}"/>
                <MenuItem x:Name="RecentMenu" Header="{loc:T menu.recent}" ItemsSource="{Binding RecentFiles}" SubmenuOpened="Recent_Opened">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Display}"/>
                            <Setter Property="Command" Value="{Binding OpenCommand}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{loc:T menu.import_image}" InputGestureText="Ctrl+I" Command="{Binding ImportCommand}"/>
                <MenuItem Header="{loc:T menu.import_from_clipboard}" InputGestureText="Ctrl+Shift+V" Command="{Binding ImportClipboardCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:T menu.save_project}" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}"/>
                <MenuItem Header="{loc:T menu.save_project_as}" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}"/>
                <!-- All export commands in one place (the Animation menu keeps its own copies on purpose); Ctrl+E is bound in Window.InputBindings -->
                <MenuItem Header="{loc:T menu.export_submenu}">
                    <MenuItem Header="{loc:T menu.export_to_png}" InputGestureText="Ctrl+E" Command="{Binding ExportPngCommand}"/>
                    <MenuItem Header="{loc:T menu.export_for_unity_godot_gif}" Command="{Binding Rsi.ExportAnimationCommand}" ToolTip="{loc:T main.png_sheet_and_descriptions_for.tip}"/>
                    <MenuItem Header="{loc:T menu.export_again}" InputGestureText="Ctrl+Shift+E" Command="{Binding Rsi.ExportAgainCommand}"/>
                    <MenuItem Header="{loc:T menu.export_layers_as_sheet}" Command="{Binding Sheet.ExportLayersSheetCommand}"/>
                    <MenuItem Header="{loc:T menu.export_slices_to_folder}" Command="{Binding Sheet.ExportSlicesCommand}"/>
                    <MenuItem Header="{loc:T menu.export_selection_mask}" Command="{Binding Canvas.ExportSelectionMaskCommand}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{loc:T menu.exit}" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:T menu.edit}">
                <MenuItem Header="{loc:T menu.undo}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <MenuItem Header="{loc:T menu.redo}" InputGestureText="Ctrl+Y / Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:T menu.copy}" InputGestureText="Ctrl+C" Command="{Binding Canvas.CopyCommand}"/>
                <MenuItem Header="{loc:T menu.cut}" InputGestureText="Ctrl+X" Command="{Binding Canvas.CutCommand}"/>
                <MenuItem Header="{loc:T menu.paste}" InputGestureText="Ctrl+V" Command="{Binding Canvas.PasteCommand}"/>
                <MenuItem Header="{loc:T menu.delete_selection}" InputGestureText="Del" Command="{Binding Canvas.DeleteCommand}"/>
                <MenuItem Header="{loc:T menu.select_all}" InputGestureText="Ctrl+A" Command="{Binding Canvas.SelectAllCommand}"/>
                <MenuItem Header="{loc:T menu.deselect}" InputGestureText="Esc / Ctrl+D" Command="{Binding Canvas.DeselectCommand}"/>
                <MenuItem Header="{loc:T menu.transform_selection}">
                    <MenuItem Header="{loc:T menu.rotate_by_angle}" Command="{Binding Canvas.RotateAskCommand}" ToolTip="{loc:T main.any_angle_without_a_selection.tip}"/>
                    <Separator/>
                    <MenuItem Header="{loc:T menu.rotate_clockwise}" Command="{Binding Canvas.RotateRightCommand}" ToolTip="{loc:T menu.rotate90_layer.tip}"/>
                    <MenuItem Header="{loc:T menu.rotate_counterclockwise}" Command="{Binding Canvas.RotateLeftCommand}" ToolTip="{loc:T menu.rotate90_layer.tip}"/>
                    <MenuItem Header="{loc:T menu.rotate_180}" Command="{Binding Canvas.Rotate180Command}" ToolTip="{loc:T menu.transform_layer.tip}"/>
                    <MenuItem Header="{loc:T menu.flip_left_to_right}" Command="{Binding Canvas.FlipHorizontalCommand}" ToolTip="{loc:T menu.transform_layer.tip}"/>
                    <MenuItem Header="{loc:T menu.flip_top_to_bottom}" Command="{Binding Canvas.FlipVerticalCommand}" ToolTip="{loc:T menu.transform_layer.tip}"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{loc:T menu.crop_canvas_to_selection}" Command="{Binding Canvas.CropToSelectionCommand}" ToolTip="{loc:T main.the_canvas_becomes_the_size.tip}"/>
                <MenuItem Header="{loc:T menu.crop_canvas_to_content}" Command="{Binding Canvas.CropToContentCommand}" ToolTip="{loc:T main.removes_empty_edges_on_all.tip}"/>
                <MenuItem Header="{loc:T menu.image_size}" Command="{Binding Canvas.ImageSizeCommand}" ToolTip="{loc:T main.scale_the_picture_all_layers.tip}"/>
                <MenuItem Header="{loc:T menu.canvas_size}" Command="{Binding Canvas.CanvasSizeCommand}" ToolTip="{loc:T main.change_the_margin_around_the.tip}"/>
                <Separator/>
                <MenuItem Header="{loc:T menu.modes}">
                    <MenuItem Header="{loc:T menu.shapes_paste_and_text_on}" IsCheckable="True" IsChecked="{Binding Canvas.NewLayerForObjects}"
                              ToolTip="{loc:T main.every_drawn_object_goes_to.tip}"/>
                    <MenuItem Header="{loc:T menu.layer_shift_wraps_around_ctrl}" IsCheckable="True" IsChecked="{Binding Canvas.WrapShift}"/>
                    <!-- Both flags live here only: SelectionOnly limits operations and templates, AllLayers affects templates only -->
                    <MenuItem Header="{loc:T menu.pipeline_selection_only}" IsCheckable="True" IsChecked="{Binding Automation.SelectionOnly}"
                              ToolTip="{loc:T menu.pipeline_selection_only.tip}"/>
                    <MenuItem Header="{loc:T menu.apply_to_all_layers}" IsCheckable="True" IsChecked="{Binding Automation.AllLayers}"
                              ToolTip="{loc:T menu.apply_to_all_layers.tip}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{loc:T menu.operations_current_layer}">
                <MenuItem Header="{loc:T menu.tune_operation}" Command="{Binding Automation.TuneOperationCommand}"
                          ToolTip="{loc:T menu.tune_operation.tip}"/>
                <Separator/>
                <!-- Background -->
                <MenuItem Header="{loc:T menu.remove_background_by_edge_color}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='removeBackground|{}'
                          ToolTip="{loc:T main.the_background_color_is_taken.tip}"/>
                <MenuItem Header="{loc:T menu.cut_out_an_object_from}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='cutout|{}'
                          ToolTip="{loc:T main.for_a_non_uniform_background.tip}"/>
                <Separator/>
                <!-- Cleanup. "Clean up sprite" runs the built-in template (by its system id) through the normal template preview; hidden if the template is gone -->
                <MenuItem Header="{loc:T menu.clean_sprite}" Command="{Binding Automation.CleanSpriteCommand}" ToolTip="{loc:T menu.clean_sprite.tip}"
                          Visibility="{Binding Automation.HasCleanSpriteTemplate, Converter={StaticResource BoolVisible}}"/>
                <!-- Small groups: the tuner lets the user choose the size (maxSize) with a live preview; the one-click item uses maxSize 3 -->
                <MenuItem Header="{loc:T menu.ops.remove_small_groups}" ToolTip="{loc:T menu.ops.remove_small_groups.tip}" Command="{Binding Automation.TuneOperationCommand}" CommandParameter='removeIslands|{"maxSize":3}'/>
                <MenuItem Header="{loc:T menu.ops.remove_debris}" ToolTip="{loc:T menu.ops.remove_debris.tip}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='removeIslands|{"maxSize":3}'/>
                <MenuItem Header="{loc:T menu.close_holes}" ToolTip="{loc:T main.fills_empty_holes_up_to.tip}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='fillHoles|{"maxSize":4}'/>
                <MenuItem Header="{loc:T menu.ops.despeckle_tune}" ToolTip="{loc:T menu.ops.despeckle_tune.tip}" Command="{Binding Automation.TuneOperationCommand}" CommandParameter='despeckle|{"maxArea":3,"diagonal":false}'/>
                <Separator/>
                <!-- Outline. "$primary" is replaced by the primary color when the command runs (black if it is empty) -->
                <MenuItem Header="{loc:T menu.outline_outside_within_the_canvas}" ToolTip="{loc:T main.outlines_the_picture_with_a.tip}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='outline|{"mode":"outside","autoPad":false,"color":"$primary"}'/>
                <MenuItem Header="{loc:T menu.colored_outline_dark_shade_of}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='outline|{"shade":true,"darken":0.55}'
                          ToolTip="{loc:T main.the_outline_around_the_sprite.tip}"/>
                <MenuItem Header="{loc:T menu.outline_inside}" ToolTip="{loc:T main.paints_the_outermost_pixels_of.tip}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='outline|{"mode":"inside","color":"$primary"}'/>
                <MenuItem Header="{loc:T menu.ops.remove_outline}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='removeOutline|{}'
                          ToolTip="{loc:T menu.ops.remove_outline.tip}"/>
                <MenuItem Header="{loc:T menu.ops.remove_dark_outline}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='removeOutline|{"dark":true}'
                          ToolTip="{loc:T menu.ops.remove_dark_outline.tip}"/>
                <Separator/>
                <!-- Color. Hue shift and Replace color open the tuner; Replace color starts with from = the color selected in the used-colors list (else the secondary color) and to = the primary color -->
                <MenuItem Header="{loc:T menu.snap_to_palette}" Command="{Binding Automation.SnapToPaletteCommand}" ToolTip="{loc:T menu.snap_to_palette.tip}"/>
                <MenuItem Header="{loc:T menu.reduce_colors}" Command="{Binding Automation.TuneOperationCommand}" CommandParameter='quantize|{}' ToolTip="{loc:T menu.reduce_colors.tip}"/>
                <MenuItem Header="{loc:T menu.brightness_contrast}" Command="{Binding Automation.TuneOperationCommand}" CommandParameter='adjust|{}' ToolTip="{loc:T menu.brightness_contrast.tip}"/>
                <MenuItem Header="{loc:T menu.ops.hue_shift}" Command="{Binding Automation.TuneOperationCommand}" CommandParameter='hueShift|{"degrees":30}'/>
                <MenuItem Header="{loc:T menu.ops.grayscale}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='grayscale|{}'/>
                <MenuItem Header="{loc:T menu.ops.auto_levels}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='autoLevels|{}'/>
                <MenuItem Header="{loc:T menu.ops.replace_color}" Command="{Binding Automation.TuneOperationCommand}" CommandParameter='replaceColor|{"from":"$selectedUsed","to":"$primary"}'
                          ToolTip="{loc:T menu.ops.replace_color.tip}"/>
                <Separator/>
                <!-- Shape and light -->
                <MenuItem Header="{loc:T menu.ops.grow}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='grow|{"amount":1}'/>
                <MenuItem Header="{loc:T menu.ops.shrink}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='shrink|{"amount":1}'/>
                <MenuItem Header="{loc:T menu.ops.mirror_lr}" Command="{Binding Automation.ApplyOperationCommand}" CommandParameter='mirror|{"mode":"left"}'/>
                <MenuItem Header="{loc:T menu.light_and_shadow_on_edges}" Command="{Binding Automation.TuneOperationCommand}" CommandParameter='light|{"from":"NW","bands":3}'
                          ToolTip="{loc:T main.edges_facing_the_light_get.tip}"/>
            </MenuItem>
            <MenuItem x:Name="PipelineMenu" Header="{loc:T menu.pipelines}" SubmenuOpened="Pipelines_Opened">
                <MenuItem Header="{loc:T menu.run_file}" Command="{Binding Automation.RunFileCommand}"/>
                <MenuItem Header="{loc:T menu.chat_pipeline}" Command="{Binding Automation.ChatPipelineCommand}"/>
                <MenuItem Header="{loc:T menu.standard_templates}" ItemsSource="{Binding Automation.SystemTemplateMenu}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Header}"/>
                            <Setter Property="Command" Value="{Binding Command}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="{loc:T menu.my_templates}" ItemsSource="{Binding Automation.UserTemplateMenu}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Header}"/>
                            <Setter Property="Command" Value="{Binding Command}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="{loc:T menu.create_template}" Command="{Binding Automation.NewTemplateCommand}"/>
                <MenuItem Header="{loc:T menu.template_manager}" Command="{Binding Automation.TemplateLibraryCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:T menu.batch_process_folder}" Command="{Binding Automation.BatchCommand}"/>
                <MenuItem Header="{loc:T menu.reference_operations_checks_plugins}" Command="{Binding Automation.ReferenceCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:T menu.animation}">
                <MenuItem Header="{loc:T menu.new_animation_sheet}" Command="{Binding Rsi.NewSheetCommand}" ToolTip="{loc:T main.a_sheet_with_zones_rows.tip}"/>
                <MenuItem Header="{loc:T menu.animation_preview_and_gif_2}" Command="{Binding Sheet.AnimationCommand}"/>
                <MenuItem Header="{loc:T menu.export_for_unity_godot_gif}" Command="{Binding Rsi.ExportAnimationCommand}" ToolTip="{loc:T main.png_sheet_and_descriptions_for.tip}"/>
                <MenuItem Header="{loc:T menu.export_again}" InputGestureText="Ctrl+Shift+E" Command="{Binding Rsi.ExportAgainCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:T menu.sheet_grid}" Command="{Binding Sheet.SheetGridCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:T menu.import_sheet_cells_to_layers}" Command="{Binding Sheet.ImportSheetCommand}"/>
                <MenuItem Header="{loc:T menu.export_layers_as_sheet}" Command="{Binding Sheet.ExportLayersSheetCommand}"/>
                <MenuItem Header="{loc:T menu.export_slices_to_folder}" Command="{Binding Sheet.ExportSlicesCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:T menu.rsi_submenu}">
                    <MenuItem Header="{loc:T menu.new_rsi}" Command="{Binding Rsi.NewProjectCommand}" ToolTip="{loc:T main.create_a_rsi_folder_with.tip}"/>
                    <MenuItem Header="{loc:T menu.new_state}" Command="{Binding Rsi.NewStateCommand}" ToolTip="{loc:T main.a_sheet_with_direction_and.tip}"/>
                    <MenuItem Header="{loc:T menu.open_state}" Command="{Binding Rsi.OpenStateCommand}"/>
                    <MenuItem Header="{loc:T menu.save_state_to_rsi}" Command="{Binding Rsi.SaveStateCommand}" Style="{StaticResource RsiSaveStateItem}"/>
                    <Separator/>
                    <MenuItem Header="{loc:T menu.rsi_metadata}" Command="{Binding Rsi.EditMetaCommand}" Style="{StaticResource RsiGatedItem}"/>
                    <MenuItem Header="{loc:T menu.open_rsi_folder}" Command="{Binding Rsi.OpenFolderCommand}" Style="{StaticResource RsiGatedItem}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{loc:T menu.view}">
                <MenuItem Header="{loc:T menu.pixel_grid}" IsCheckable="True" IsChecked="{Binding Canvas.ShowPixelGrid}"/>
                <MenuItem Header="{loc:T menu.real_size_preview}" Command="{Binding OpenPreviewCommand}"
                          ToolTip="{loc:T main.a_window_with_the_picture.tip}"/>
                <Separator/>
                <MenuItem Header="{loc:T menu.fit_to_window}" InputGestureText="F / Ctrl+0" Command="{Binding Canvas.FitCommand}"/>
                <MenuItem Header="{loc:T menu.zoom_100}" InputGestureText="Ctrl+1" Command="{Binding Canvas.ZoomActualCommand}"/>
                <MenuItem Header="{loc:T menu.zoom_in}" InputGestureText="+" Command="{Binding Canvas.ZoomInCommand}"/>
                <MenuItem Header="{loc:T menu.zoom_out}" InputGestureText="-" Command="{Binding Canvas.ZoomOutCommand}"/>
            </MenuItem>
            <MenuItem Header="{loc:T menu.help}">
                <MenuItem Header="{loc:T menu.open_log_folder}" Command="{Binding OpenLogFolderCommand}"/>
                <Separator/>
                <MenuItem Header="{loc:T menu.about}" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Status bar: message on the left, segments on the right -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="{Binding Rsi.StatusLine}" Style="{StaticResource MutedText}"/></StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="{Binding Canvas.PositionText}" MinWidth="56"/></StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="{Binding Canvas.ZoomText}"/></StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock Text="{Binding Canvas.DocumentSizeText}"/></StatusBarItem>
            <StatusBarItem><TextBlock Text="{Binding Session.StatusText}"/></StatusBarItem>
        </StatusBar>

        <!-- Left panel: tools, their options and the color -->
        <Border DockPanel.Dock="Left" Width="216" Background="{DynamicResource Brush.Surface2}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8">
                    <RadioButton Content="{loc:T main.pencil}" ui:Ui.IconData="{StaticResource Icon.Pencil}" ui:Ui.Hotkey="B" GroupName="T" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Pencil}"
                                 ToolTip="{loc:T main.draws_with_the_primary_color.tip}"/>
                    <RadioButton Content="{loc:T main.eraser}" ui:Ui.IconData="{StaticResource Icon.Eraser}" ui:Ui.Hotkey="E" GroupName="T" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Eraser}"
                                 ToolTip="{loc:T main.erases_pixels_to_transparency.tip}"/>
                    <RadioButton Content="{loc:T main.bg_eraser}" ui:Ui.IconData="{StaticResource Icon.BgEraser}" ui:Ui.Hotkey="K" GroupName="T" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=BgEraser}"
                                 ToolTip="{loc:T main.bg_eraser.tip}"/>
                    <RadioButton Content="{loc:T main.fill}" ui:Ui.IconData="{StaticResource Icon.Bucket}" ui:Ui.Hotkey="G" GroupName="T" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Fill}"
                                 ToolTip="{loc:T main.fills_an_area_of_a.tip}"/>
                    <RadioButton Content="{loc:T main.eyedropper}" ui:Ui.IconData="{StaticResource Icon.Dropper}" ui:Ui.Hotkey="I" GroupName="T" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Picker}"
                                 ToolTip="{loc:T main.picks_a_color_from_the.tip}"/>
                    <RadioButton Content="{loc:T main.shapes}" ui:Ui.IconData="{Binding Canvas.LastShapeTool, Converter={StaticResource ToolIcon}}" ui:Ui.Hotkey="L R O" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.IsShapeGroup, Mode=OneWay}"
                                 Command="{Binding Canvas.SelectToolCommand}" CommandParameter="{Binding Canvas.LastShapeTool}"
                                 ToolTip="{loc:T main.shapes.tip}">
                                 <RadioButton.ContextMenu>
                                     <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                         <MenuItem Header="{loc:T main.line}" Command="{Binding Canvas.SelectToolCommand}" CommandParameter="Line"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Line}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                         <MenuItem Header="{loc:T main.rectangle}" Command="{Binding Canvas.SelectToolCommand}" CommandParameter="Rect"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Rect}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                         <MenuItem Header="{loc:T main.ellipse}" Command="{Binding Canvas.SelectToolCommand}" CommandParameter="Ellipse"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Ellipse}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                     </ContextMenu>
                                 </RadioButton.ContextMenu>
                    </RadioButton>
                    <RadioButton Content="{loc:T main.selection}" ui:Ui.IconData="{Binding Canvas.LastSelectionTool, Converter={StaticResource ToolIcon}}" ui:Ui.Hotkey="M W S P" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.IsSelectionGroup, Mode=OneWay}"
                                 Command="{Binding Canvas.SelectToolCommand}" CommandParameter="{Binding Canvas.LastSelectionTool}"
                                 ToolTip="{loc:T main.selection_group.tip}">
                                 <RadioButton.ContextMenu>
                                     <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                         <MenuItem Header="{loc:T main.rectangle}" Command="{Binding Canvas.SelectToolCommand}" CommandParameter="Select"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Select}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                         <MenuItem Header="{loc:T main.magic_wand}" Command="{Binding Canvas.SelectToolCommand}" CommandParameter="Wand"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Wand}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                         <MenuItem Header="{loc:T main.lasso}" Command="{Binding Canvas.SelectToolCommand}" CommandParameter="Lasso"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Lasso}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                         <MenuItem Header="{loc:T main.polygon_selection}" Command="{Binding Canvas.SelectToolCommand}" CommandParameter="Polygon"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Polygon}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                     </ContextMenu>
                                 </RadioButton.ContextMenu>
                    </RadioButton>
                    <RadioButton Content="{loc:T main.move}" ui:Ui.IconData="{StaticResource Icon.Move}" ui:Ui.Hotkey="V" GroupName="T" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Move}"
                                 ToolTip="{loc:T main.press_on_an_object_and.tip}"/>
                    <RadioButton Content="{loc:T main.gradient}" ui:Ui.IconData="{StaticResource Icon.Gradient}" ui:Ui.Hotkey="D" GroupName="T" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Gradient}"
                                 ToolTip="{loc:T main.drag_from_start_to_end.tip}"/>
                    <RadioButton Content="{loc:T main.lighter_darker}" ui:Ui.IconData="{StaticResource Icon.Shade}" ui:Ui.IconFilled="True" ui:Ui.Hotkey="U" GroupName="T" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Shade}"
                                 ToolTip="{loc:T main.a_brush_that_lightens_left.tip}"/>
                    <RadioButton Content="{loc:T main.text}" ui:Ui.IconData="{StaticResource Icon.Text}" ui:Ui.IconFilled="True" ui:Ui.Hotkey="T" GroupName="T" Style="{StaticResource ToolButtonStyle}"
                                 IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Text}"
                                 ToolTip="{loc:T main.click_on_the_canvas_enter.tip}"/>

                    <!-- Options of the selected tool: only the ones that belong to it are shown -->
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="4,10,0,0">
                        <StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsShapeGroup, Converter={StaticResource BoolVisible}}" Margin="0,0,0,10">
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource ChipStyle}" GroupName="IsShapeGroup" IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Line}" ToolTip="{loc:T main.line}" Padding="8,5"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Line}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></RadioButton>
                                    <RadioButton Style="{StaticResource ChipStyle}" GroupName="IsShapeGroup" IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Rect}" ToolTip="{loc:T main.rectangle}" Padding="8,5"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Rect}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></RadioButton>
                                    <RadioButton Style="{StaticResource ChipStyle}" GroupName="IsShapeGroup" IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Ellipse}" ToolTip="{loc:T main.ellipse}" Padding="8,5"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Ellipse}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></RadioButton>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsSelectionGroup, Converter={StaticResource BoolVisible}}" Margin="0,0,0,10">
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource ChipStyle}" GroupName="IsSelectionGroup" IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Select}" ToolTip="{loc:T main.rectangle}" Padding="8,5"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Select}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></RadioButton>
                                    <RadioButton Style="{StaticResource ChipStyle}" GroupName="IsSelectionGroup" IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Wand}" ToolTip="{loc:T main.magic_wand}" Padding="8,5"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Wand}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></RadioButton>
                                    <RadioButton Style="{StaticResource ChipStyle}" GroupName="IsSelectionGroup" IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Lasso}" ToolTip="{loc:T main.lasso}" Padding="8,5"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Lasso}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></RadioButton>
                                    <RadioButton Style="{StaticResource ChipStyle}" GroupName="IsSelectionGroup" IsChecked="{Binding Canvas.Tool, Converter={StaticResource EnumBool}, ConverterParameter=Polygon}" ToolTip="{loc:T main.polygon_selection}" Padding="8,5"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Polygon}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox></RadioButton>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsBrushTool, Converter={StaticResource BoolVisible}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding Canvas.BrushSize, StringFormat={}{0:0} px}"/>
                                    <TextBlock Text="{loc:T main.brush_size}"/>
                                </DockPanel>
                                <Slider Minimum="1" Maximum="16" Value="{Binding Canvas.BrushSize}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,0,0"/>
                                <TextBlock Text="{loc:T main.symmetry}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                                <CheckBox Content="{loc:T main.left_right}" Margin="0,6,0,0" IsChecked="{Binding Canvas.MirrorX}"
                                          ToolTip="{loc:T main.every_stroke_is_repeated_on.tip}"/>
                                <CheckBox Content="{loc:T main.top_bottom}" Margin="0,6,0,0" IsChecked="{Binding Canvas.MirrorY}"
                                          ToolTip="{loc:T main.every_stroke_is_repeated_on.tip_2}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsShapeTool, Converter={StaticResource BoolVisible}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding Canvas.ShapeThickness, StringFormat={}{0:0} px}"/>
                                    <TextBlock Text="{loc:T main.outline_thickness}"/>
                                </DockPanel>
                                <Slider Minimum="1" Maximum="16" Value="{Binding Canvas.ShapeThickness}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,0,0"/>
                                <CheckBox Content="{loc:T main.fill_inside}" Margin="0,9,0,0" IsChecked="{Binding Canvas.FilledShapes}"
                                          ToolTip="{loc:T main.otherwise_only_the_outline_is.tip}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsFillTool, Converter={StaticResource BoolVisible}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                                               Text="{Binding Canvas.FillTolerance, StringFormat={}{0:0}}"/>
                                    <TextBlock Text="{loc:T main.tolerance}"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="255" Value="{Binding Canvas.FillTolerance}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,0,0"
                                        ToolTip="{loc:T main.0_exactly_the_same_color.tip}"/>
                                <CheckBox Content="{loc:T main.whole_layer}" Margin="0,9,0,0" IsChecked="{Binding Canvas.FillWholeLayer}"
                                          ToolTip="{loc:T main.paints_all_similar_pixels_of.tip}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsPickerTool, Converter={StaticResource BoolVisible}}">
                                <CheckBox Content="{loc:T main.pick_color_from_layer_only}" IsChecked="{Binding Canvas.PickFromLayerOnly}"
                                          ToolTip="{loc:T main.otherwise_the_color_is_taken.tip}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsSelectTool, Converter={StaticResource BoolVisible}}">
                                <CheckBox Content="{loc:T main.coordinate_grid}" IsChecked="{Binding Canvas.ShowSelectionGrid}"
                                          ToolTip="{loc:T main.pixel_numbers_along_the_selection.tip}"/>
                                <StackPanel Margin="18,6,0,0" Visibility="{Binding Canvas.ShowSelectionGrid, Converter={StaticResource BoolVisible}}">
                                    <RadioButton Content="{loc:T main.canvas_coordinates}" GroupName="GM" IsChecked="{Binding Canvas.SelectionGridLocal, Converter={StaticResource EnumBool}, ConverterParameter=False}"
                                                 ToolTip="{loc:T main.pixel_numbers_as_on_the.tip}"/>
                                    <RadioButton Content="{loc:T main.from_selection_corner}" GroupName="GM" Margin="0,5,0,0" IsChecked="{Binding Canvas.SelectionGridLocal, Converter={StaticResource EnumBool}, ConverterParameter=True}"
                                                 ToolTip="{loc:T main.numbering_from_zero_at_the.tip}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsWandTool, Converter={StaticResource BoolVisible}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding Canvas.WandTolerance, StringFormat={}{0:0}}"/>
                                    <TextBlock Text="{loc:T main.color_tolerance}"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="128" Value="{Binding Canvas.WandTolerance}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,0,0"
                                        ToolTip="{loc:T main.0_exactly_the_same_color.tip_2}"/>
                                <CheckBox Content="{loc:T main.adjacent_pixels_only}" Margin="0,9,0,0" IsChecked="{Binding Canvas.WandContiguous}"
                                          ToolTip="{loc:T main.off_all_pixels_of_this.tip}"/>
                                <CheckBox Content="{loc:T main.wand_follow_smooth}" Margin="0,9,0,0" IsChecked="{Binding Canvas.WandFollow}"
                                          ToolTip="{loc:T main.wand_follow_smooth.tip}"/>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,9,0,0" Text="{loc:T main.wand_hint}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsBgEraserTool, Converter={StaticResource BoolVisible}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding Canvas.EraserTolerance, StringFormat={}{0:0}}"/>
                                    <TextBlock Text="{loc:T main.color_tolerance}"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="128" Value="{Binding Canvas.EraserTolerance}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,0,0"
                                        ToolTip="{loc:T main.0_exactly_the_same_color.tip_2}"/>
                                <CheckBox Content="{loc:T main.adjacent_pixels_only}" Margin="0,9,0,0" IsChecked="{Binding Canvas.EraserContiguous}"
                                          ToolTip="{loc:T main.off_all_pixels_of_this.tip}"/>
                                <CheckBox Content="{loc:T main.wand_follow_smooth}" Margin="0,9,0,0" IsChecked="{Binding Canvas.EraserFollow}"
                                          ToolTip="{loc:T main.wand_follow_smooth.tip}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsGradientTool, Converter={StaticResource BoolVisible}}">
                                <!-- Transition kind as icons: pattern, steps, smooth (names in tooltips) -->
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource ChipStyle}" GroupName="G" Padding="5" Margin="0,0,6,0"
                                                 IsChecked="{Binding Canvas.GradientKind, Converter={StaticResource EnumBool}, ConverterParameter=Dither}"
                                                 ToolTip="{loc:T main.dithering_2_colors_pattern}">
                                        <Grid Width="54" Height="30">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="0" Fill="{DynamicResource Brush.Accent}"/>
                                            <Rectangle Grid.Column="1">
                                                <Rectangle.Fill>
                                                    <DrawingBrush Viewport="0,0,6,6" ViewportUnits="Absolute" TileMode="Tile">
                                                        <DrawingBrush.Drawing>
                                                            <GeometryDrawing Brush="{DynamicResource Brush.Accent}">
                                                                <GeometryDrawing.Geometry>
                                                                    <GeometryGroup>
                                                                        <RectangleGeometry Rect="0,0,3,3"/>
                                                                        <RectangleGeometry Rect="3,3,3,3"/>
                                                                    </GeometryGroup>
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                        </DrawingBrush.Drawing>
                                                    </DrawingBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ChipStyle}" GroupName="G" Padding="5" Margin="0,0,6,0"
                                                 IsChecked="{Binding Canvas.GradientKind, Converter={StaticResource EnumBool}, ConverterParameter=Steps}"
                                                 ToolTip="{loc:T main.steps}">
                                        <UniformGrid Rows="1" Width="54" Height="30">
                                            <Rectangle Fill="{DynamicResource Brush.Accent}"/>
                                            <Rectangle Fill="{DynamicResource Brush.Accent}" Opacity="0.66"/>
                                            <Rectangle Fill="{DynamicResource Brush.Accent}" Opacity="0.36"/>
                                            <Rectangle Fill="{DynamicResource Brush.Accent}" Opacity="0.12"/>
                                        </UniformGrid>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource ChipStyle}" GroupName="G" Padding="5"
                                                 IsChecked="{Binding Canvas.GradientKind, Converter={StaticResource EnumBool}, ConverterParameter=Smooth}"
                                                 ToolTip="{loc:T main.smooth}">
                                        <Rectangle Width="54" Height="30">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="{DynamicResource Color.Accent}" Offset="0"/>
                                                    <GradientStop Color="#004CC2FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </RadioButton>
                                </WrapPanel>
                                <StackPanel Visibility="{Binding Canvas.IsGradientSteps, Converter={StaticResource BoolVisible}}">
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding Canvas.GradientSteps, StringFormat={}{0:0}}"/>
                                        <TextBlock Text="{loc:T main.number_of_bands}"/>
                                    </DockPanel>
                                    <Slider Minimum="2" Maximum="16" Value="{Binding Canvas.GradientSteps}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsShadeTool, Converter={StaticResource BoolVisible}}">
                                <!-- What to change with the brush: brightness or hue (icons, names in tooltips); the margin separates it from brush size and symmetry -->
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                    <WrapPanel>
                                        <RadioButton Style="{StaticResource ChipStyle}" GroupName="S" Padding="5" Margin="0,0,6,0"
                                                     IsChecked="{Binding Canvas.ShadeKind, Converter={StaticResource EnumBool}, ConverterParameter=Brightness}"
                                                     ToolTip="{loc:T main.brightness}">
                                            <Rectangle Width="54" Height="30">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#202020" Offset="0"/>
                                                        <GradientStop Color="#808080" Offset="0.5"/>
                                                        <GradientStop Color="#FFFFFF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource ChipStyle}" GroupName="S" Padding="5"
                                                     IsChecked="{Binding Canvas.ShadeKind, Converter={StaticResource EnumBool}, ConverterParameter=Hue}"
                                                     ToolTip="{loc:T main.hue}">
                                            <Rectangle Width="54" Height="30">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FF3B30" Offset="0"/>
                                                        <GradientStop Color="#FFCC00" Offset="0.2"/>
                                                        <GradientStop Color="#34C759" Offset="0.4"/>
                                                        <GradientStop Color="#32ADE6" Offset="0.6"/>
                                                        <GradientStop Color="#5856D6" Offset="0.8"/>
                                                        <GradientStop Color="#FF2D92" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </RadioButton>
                                    </WrapPanel>
                                </Border>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding Canvas.ShadeAmount, StringFormat={}{0:0}%}"/>
                                    <TextBlock Text="{loc:T main.strength}"/>
                                </DockPanel>
                                <Slider Minimum="1" Maximum="40" Value="{Binding Canvas.ShadeAmount}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsTextTool, Converter={StaticResource BoolVisible}}">
                                <TextBlock Text="{loc:T main.text_font}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="TextFontBox" ItemsSource="{Binding Canvas.TextFonts}" SelectedItem="{Binding Canvas.TextFont}" Margin="0,0,0,8"
                                          DropDownClosed="TextOption_Done">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="{Binding SampleWidth}" Height="{Binding SampleHeight}" Fill="{DynamicResource Brush.Text}"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="{Binding Sample, Converter={StaticResource PixelBitmap}}"/>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="{Binding Canvas.TextScale, StringFormat={}{0:0}×}"/>
                                    <TextBlock Text="{loc:T main.text_size}"/>
                                </DockPanel>
                                <Slider Minimum="1" Maximum="4" Value="{Binding Canvas.TextScale}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,0,0"
                                        PreviewMouseLeftButtonUp="TextOption_Done"/>
                                <TextBlock Text="{loc:T main.text_hint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding Canvas.IsMoveTool, Converter={StaticResource BoolVisible}}">
                                <TextBlock Text="{loc:T main.rotation}" Margin="0,10,0,4"/>
                                <WrapPanel>
                                    <Button Content="↻ 90°" Margin="0,0,4,4" Command="{Binding Canvas.RotateByCommand}" CommandParameter="90" ToolTip="{loc:T main.clockwise_by_90.tip}"/>
                                    <Button Content="↺ 90°" Margin="0,0,4,4" Command="{Binding Canvas.RotateByCommand}" CommandParameter="-90" ToolTip="{loc:T main.counterclockwise_by_90.tip}"/>
                                    <Button Content="180°" Margin="0,0,4,4" Command="{Binding Canvas.RotateByCommand}" CommandParameter="180"/>
                                    <Button Content="{loc:T main.angle}" Margin="0,0,4,4" Command="{Binding Canvas.RotateAskCommand}" ToolTip="{loc:T main.rotate_by_any_angle.tip}"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Color -->
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="4,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:T main.color}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="⇄" Style="{StaticResource IconButton}" Margin="6,0,0,0" Command="{Binding Colors.SwapColorsCommand}"
                                        ToolTip="{loc:T main.swap_primary_and_secondary_color.tip}"/>
                                <Grid DockPanel.Dock="Left" Width="38" Height="30" Margin="0,0,10,0"
                                      ToolTip="{loc:T main.primary_color_left_button_and.tip}">
                                    <Border Width="24" Height="24" Margin="12,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            BorderBrush="{DynamicResource Brush.BorderHi}" BorderThickness="1" CornerRadius="3"
                                            Background="{StaticResource Brush.CheckerSmall}">
                                        <Border Background="{Binding Colors.Secondary, Converter={StaticResource ColorBrush}}" CornerRadius="2"/>
                                    </Border>
                                    <Border Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            BorderBrush="{DynamicResource Brush.BorderHi}" BorderThickness="1" CornerRadius="3"
                                            Background="{StaticResource Brush.CheckerSmall}">
                                        <Border Background="{Binding Colors.Primary, Converter={StaticResource ColorBrush}}" CornerRadius="2"/>
                                    </Border>
                                </Grid>
                                <TextBox Style="{StaticResource MonoTextBox}" CharacterCasing="Upper"
                                         Text="{Binding Colors.PrimaryHex, UpdateSourceTrigger=LostFocus}"
                                         KeyDown="HexBox_KeyDown" ToolTip="{loc:T main.primary_color_rrggbb.tip}"/>
                            </DockPanel>

                            <!-- Picker mode: HSV square or RGB sliders (remembered in settings) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <RadioButton Style="{StaticResource ChipStyle}" GroupName="ColorMode" Content="HSV" Padding="8,3" Margin="0,1,2,1"
                                             IsChecked="{Binding Colors.ShowHsv}" ToolTip="{loc:T main.color_mode_hsv.tip}"/>
                                <RadioButton Style="{StaticResource ChipStyle}" GroupName="ColorMode" Content="RGB" Padding="8,3" Margin="0,1,2,1"
                                             IsChecked="{Binding Colors.ShowRgb}" ToolTip="{loc:T main.color_mode_rgb.tip}"/>
                            </StackPanel>
                            <local:HsvPicker Margin="0,0,0,2" Visibility="{Binding Colors.ShowHsv, Converter={StaticResource BoolVisible}}"
                                             Hue="{Binding Colors.Hue}" Saturation="{Binding Colors.Saturation}" Value="{Binding Colors.Value}"/>
                            <StackPanel Visibility="{Binding Colors.ShowRgb, Converter={StaticResource BoolVisible}}">
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="R" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Maximum="255" Foreground="#EF4444" Margin="7,0" Value="{Binding Colors.Red}"/>
                                <TextBox Grid.Column="2" Style="{StaticResource NumericTextBox}" Text="{Binding Colors.Red, StringFormat=0, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="G" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Maximum="255" Foreground="#22C55E" Margin="7,0" Value="{Binding Colors.Green}"/>
                                <TextBox Grid.Column="2" Style="{StaticResource NumericTextBox}" Text="{Binding Colors.Green, StringFormat=0, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="B" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Maximum="255" Foreground="#3B82F6" Margin="7,0" Value="{Binding Colors.Blue}"/>
                                <TextBox Grid.Column="2" Style="{StaticResource NumericTextBox}" Text="{Binding Colors.Blue, StringFormat=0, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                            </StackPanel>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="{loc:T main.to_palette}" Command="{Binding Colors.AddToPaletteCommand}"
                                        ToolTip="{loc:T main.add_this_color_to_the.tip}"/>
                                <Button Grid.Column="1" Content="{loc:T main.shades}" Margin="4,0,0,0" Command="{Binding Colors.ShadesCommand}"
                                        ToolTip="{loc:T main.shades.tip}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right panel: palette, layers, used colors -->
        <Border DockPanel.Dock="Right" Width="300" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <HeaderedContentControl Header="{loc:T menu.palette_2}" Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <!-- "More" menu: the palette commands that used to live in the top-level Palette menu (opened by PaletteMore_Click) -->
                                <Button DockPanel.Dock="Right" Content="⋯" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="PaletteMore_Click"
                                        ToolTip="{loc:T main.palette_more.tip}">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{loc:T menu.sort_by_brightness}" Command="{Binding Colors.SortByLuminanceCommand}"/>
                                            <MenuItem Header="{loc:T menu.sort_by_hue}" Command="{Binding Colors.SortByHueCommand}"/>
                                            <MenuItem Header="{loc:T menu.remove_unused_colors}" Command="{Binding Colors.RemoveUnusedCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="{loc:T menu.palette_from_image}" Command="{Binding Colors.PaletteFromImageCommand}" ToolTip="{loc:T main.replaces_the_palette_with_the.tip}"/>
                                            <MenuItem Header="{loc:T menu.save_to_library}" Command="{Binding Colors.SavePaletteToLibraryCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button DockPanel.Dock="Right" Content="{loc:T main.library}" Margin="6,0,0,0" Command="{Binding Colors.PaletteLibraryCommand}"
                                        ToolTip="{loc:T main.ready_made_and_your_own.tip}"/>
                                <TextBlock Text="{Binding Colors.PaletteTitle}" Style="{StaticResource SectionTitleText}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding Colors.PaletteTitle}"/>
                            </DockPanel>
                            <!-- Recently used colors (painted with, most recent first): left button primary, right button secondary -->
                            <TextBlock Text="{loc:T main.recent_colors}" Style="{StaticResource CaptionText}" Margin="0,0,0,2"/>
                            <ListBox x:Name="RecentList" PreviewMouseDown="PaletteList_PreviewMouseDown" Margin="-2,0,-2,5" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemsSource="{Binding Colors.Recent}" ItemContainerStyle="{StaticResource SwatchItemStyle}"
                                     ToolTip="{loc:T main.recent_colors.tip}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="8" Rows="1"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="20" Background="{Binding Converter={StaticResource ColorBrush}}"
                                                BorderBrush="#55000000" BorderThickness="1" CornerRadius="2"
                                                ToolTip="{Binding Converter={StaticResource ColorHex}}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ListBox x:Name="PaletteList" PreviewMouseDown="PaletteList_PreviewMouseDown"
                                     ItemsSource="{Binding Colors.Palette}" SelectedItem="{Binding Colors.SelectedPaletteColor}"
                                     ItemContainerStyle="{StaticResource SwatchItemStyle}" Margin="-2,0,-2,5">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="20" Background="{Binding Converter={StaticResource ColorBrush}}"
                                                BorderBrush="#55000000" BorderThickness="1" CornerRadius="2"
                                                ToolTip="{Binding Converter={StaticResource ColorHex}}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{loc:T main.left_mouse_button_primary_color}" Style="{StaticResource CaptionText}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <Button Content="{loc:T main.remove_selected}" Margin="0,0,4,4" Command="{Binding Colors.RemoveFromPaletteCommand}"
                                        ToolTip="{loc:T main.remove_the_color_selected_in.tip}"/>
                            </WrapPanel>
                            <TextBlock Text="{loc:T main.from_image_from_file_sorting}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="{loc:T menu.layers}" Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <ListBox x:Name="LayersList" ItemsSource="{Binding Layers.Items}" SelectedItem="{Binding Layers.SelectedItem}" MaxHeight="220" Margin="0,0,0,6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="IsSelected" Value="True"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Height="36">
                                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource EyeToggleStyle}" IsChecked="{Binding Visible}"
                                                          ToolTip="{loc:T main.show_or_hide_the_layer.tip}"/>
                                            <Border DockPanel.Dock="Left" Width="32" Height="32" Margin="2,0,8,0" BorderBrush="{DynamicResource Brush.BorderHi}"
                                                    BorderThickness="1" Background="{StaticResource Brush.CheckerSmall}">
                                                <Image Source="{Binding Thumbnail, Converter={StaticResource PixelBitmap}}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource LockToggleStyle}" IsChecked="{Binding Locked}"
                                                          ToolTip="{loc:T main.lock_the_layer_against_edits.tip}"/>
                                            <!-- Rename: the pencil, F2 or a double click on the name start the editor; Enter or focus loss commits, Esc cancels -->
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding BeginEditCommand}"
                                                    Content="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" MinWidth="24" MinHeight="24" Padding="0" VerticalAlignment="Center"
                                                    Foreground="{DynamicResource Brush.Muted}" Background="Transparent" BorderThickness="0"
                                                    ToolTip="{loc:T layers.rename.tip}"/>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Margin="3,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Background="Transparent"
                                                           ToolTip="{Binding Name}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding BeginEditCommand}"/>
                                                    </TextBlock.InputBindings>
                                                </TextBlock>
                                                <TextBox Style="{StaticResource InlineTextBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsEditing, Converter={StaticResource BoolVisible}}"
                                                         IsVisibleChanged="LayerNameBox_IsVisibleChanged" LostKeyboardFocus="LayerNameBox_LostKeyboardFocus">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Return" Command="{Binding CommitEditCommand}"/>
                                                        <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}"/>
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </Grid>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <UniformGrid Columns="6">
                                <Button Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" Command="{Binding Layers.AddCommand}" ToolTip="{loc:T main.new_layer.tip}"/>
                                <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" Command="{Binding Layers.DuplicateCommand}" ToolTip="{loc:T main.duplicate_layer.tip}"/>
                                <Button Content="&#xE74A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" Command="{Binding Layers.MoveUpCommand}" ToolTip="{loc:T main.move_up.tip}"/>
                                <Button Content="&#xE74B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" Command="{Binding Layers.MoveDownCommand}" ToolTip="{loc:T main.move_down.tip}"/>
                                <Button Content="&#xE8CB;" FontFamily="Segoe MDL2 Assets" Margin="0,0,4,0" Command="{Binding Layers.MergeDownCommand}" ToolTip="{loc:T main.merge_with_the_layer_below.tip}"/>
                                <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Command="{Binding Layers.RemoveCommand}" ToolTip="{loc:T main.delete_layer.tip}"/>
                            </UniformGrid>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="{loc:T main.show_only_layer}" Command="{Binding Layers.ShowOnlyCommand}" Margin="0,0,4,4"/>
                                <Button Content="{loc:T main.show_all_layers}" Command="{Binding Layers.ShowAllCommand}" Margin="0,0,4,4"/>
                                <Button Content="{loc:T main.merge_visible}" Command="{Binding Layers.MergeVisibleCommand}" Margin="0,0,4,4"
                                        ToolTip="{loc:T main.merge_visible.tip}"/>
                            </WrapPanel>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Header="{Binding Colors.StatsHeader}" Style="{StaticResource PanelSection}">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Colors.Stats}" SelectedItem="{Binding Colors.SelectedStat}" MaxHeight="170" Margin="0,0,0,6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="22">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="15" Height="15" HorizontalAlignment="Left" CornerRadius="2"
                                                    BorderBrush="{DynamicResource Brush.BorderHi}" BorderThickness="1"
                                                    Background="{Binding Color, Converter={StaticResource ColorBrush}}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                                                       Text="{Binding Color, Converter={StaticResource ColorHex}}"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                                       Text="{Binding Count, StringFormat={}{0} px}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{loc:T main.for_the_color_selected_in}" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <Button Content="{loc:T main.recolor_to_primary}" Margin="0,0,4,4" Command="{Binding Colors.ReplaceStatColorCommand}"
                                        ToolTip="{loc:T main.replaces_this_color_with_the.tip}"/>
                                <Button Content="{loc:T main.delete_pixels_of_color}" Margin="0,0,4,4" Command="{Binding Colors.DeleteStatColorCommand}"
                                        ToolTip="{loc:T main.delete_pixels_of_color.tip}"/>
                                <Button Content="{loc:T main.add_to_palette}" Margin="0,0,4,4" Command="{Binding Colors.StatToPaletteCommand}"
                                        ToolTip="{loc:T main.puts_this_color_into_the.tip}"/>
                            </WrapPanel>
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Work area -->
        <Grid Background="{DynamicResource Brush.Workspace}" PreviewMouseLeftButtonDown="Workspace_MouseDown">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="Scroller_PreviewMouseWheel">
                <Border Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid x:Name="CanvasHost" Cursor="Cross" Background="Transparent"
                          MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp"
                          LostMouseCapture="Canvas_LostCapture" MouseLeave="Canvas_MouseLeave">
                        <Rectangle x:Name="CheckerRect" IsHitTestVisible="False"/>
                        <Image x:Name="CanvasImage" Stretch="Fill" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
                        <Canvas x:Name="RsiZones" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
                        <Rectangle x:Name="GridRect" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <Rectangle x:Name="SheetRect" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <Rectangle x:Name="SelectionOuter" IsHitTestVisible="False" Visibility="Collapsed"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="#0078D4" StrokeThickness="0.1"/>
                        <Rectangle x:Name="SelectionRect" IsHitTestVisible="False" Visibility="Collapsed"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#204CC2FF" Stroke="#D5F3FF" StrokeThickness="0.1"/>
                        <Rectangle x:Name="TextFrameRect" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Stroke="#4CC2FF" StrokeThickness="0.1" StrokeDashArray="3 3"/>
                        <Rectangle x:Name="TextCaretRect" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Fill="White" Stroke="#99000000" StrokeThickness="0.05"/>
                        <Canvas x:Name="SelGrid" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
                        <Path x:Name="BrushCursorDark" IsHitTestVisible="False" Visibility="Collapsed" Stroke="#99000000"/>
                        <Path x:Name="BrushCursor" IsHitTestVisible="False" Visibility="Collapsed" Stroke="White" Fill="#2AFFFFFF"/>
                        <Polyline x:Name="LassoLine" IsHitTestVisible="False" Visibility="Collapsed" Stroke="#4CC2FF" StrokeLineJoin="Round"/>
                        <Image x:Name="SelMaskImage" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"/>
                        <Path x:Name="SelMaskOuter" IsHitTestVisible="False" Visibility="Collapsed" Stroke="#0078D4" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
                        <Path x:Name="SelMaskInner" IsHitTestVisible="False" Visibility="Collapsed" Stroke="#D5F3FF"/>
                        <Polygon x:Name="RotFrame" IsHitTestVisible="False" Visibility="Collapsed" Stroke="#0078D4" Fill="#140078D4"/>
                        <Line x:Name="RotStem" IsHitTestVisible="False" Visibility="Collapsed" Stroke="#0078D4"/>
                        <Ellipse x:Name="RotHandle" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="White" Stroke="#0078D4"/>
                        <Rectangle x:Name="Handle1" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="White" Stroke="#0078D4"/>
                        <Rectangle x:Name="Handle2" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="White" Stroke="#0078D4"/>
                        <Rectangle x:Name="Handle3" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="White" Stroke="#0078D4"/>
                        <Rectangle x:Name="Handle4" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="White" Stroke="#0078D4"/>
                        <Rectangle x:Name="Handle5" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="White" Stroke="#0078D4"/>
                        <Rectangle x:Name="Handle6" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="White" Stroke="#0078D4"/>
                        <Rectangle x:Name="Handle7" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="White" Stroke="#0078D4"/>
                        <Rectangle x:Name="Handle8" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="White" Stroke="#0078D4"/>
                        <!-- Canvas resize grips outside the right and bottom edges and the corner (as in Paint) and the dashed frame shown while dragging -->
                        <Rectangle x:Name="CanvasResizeFrame" IsHitTestVisible="False" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="#0078D4"/>
                        <!-- a Canvas does not clip or limit its children, so the grips outside the canvas edges stay visible and clickable -->
                        <Canvas x:Name="GripLayer" HorizontalAlignment="Left" VerticalAlignment="Top" Width="0" Height="0">
                            <Rectangle x:Name="GripR" Tag="R" Cursor="SizeWE" Fill="White" Stroke="#0078D4"
                                       MouseLeftButtonDown="Grip_MouseDown" ToolTip="{loc:T canvas.resize_grip.tip}"/>
                            <Rectangle x:Name="GripB" Tag="B" Cursor="SizeNS" Fill="White" Stroke="#0078D4"
                                       MouseLeftButtonDown="Grip_MouseDown" ToolTip="{loc:T canvas.resize_grip.tip}"/>
                            <Rectangle x:Name="GripBR" Tag="RB" Cursor="SizeNWSE" Fill="White" Stroke="#0078D4"
                                       MouseLeftButtonDown="Grip_MouseDown" ToolTip="{loc:T canvas.resize_grip.tip}"/>
                        </Canvas>
                    </Grid>
                </Border>
            </ScrollViewer>

            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0" Padding="7,4" CornerRadius="3"
                    Background="#CC191919" IsHitTestVisible="False">
                <TextBlock Text="{Binding Canvas.WorkspaceLabel}" Foreground="#DDDDDD" FontSize="{DynamicResource FontSize.Small}"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
