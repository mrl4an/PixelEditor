<Window x:Class="PixelEditor.App.RsiOpenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PixelEditor.App.Localization"
        Width="480" Height="420" MinHeight="320" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:T common.browse}" Margin="6,0,0,0" Command="{Binding BrowseCommand}"/>
            <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:T rsi_open.rsi_folder_contains_meta_json.tip}"/>
        </DockPanel>
        <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}"/>
        <TextBlock Grid.Row="2" Style="{StaticResource ErrorText}" Margin="0,8,0,0" Text="{Binding Error}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:T rsi_open.open}" IsDefault="True" MinWidth="100" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" Command="{Binding OkCommand}"/>
            <Button Content="{loc:T common.cancel}" IsCancel="True" Width="80" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
